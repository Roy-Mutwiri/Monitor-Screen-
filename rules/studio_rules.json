    "content_warning": {
      "label": "Content warning",
      "severity": "medium",
      "priority": 60,
      "any": [
        "content warning",
        "warning: your live",
        "may violate",
        "might violate",
        "potential violation",
        "review our community guidelines",
        "please review the community guidelines",
        "this content may not be appropriate",
        "inappropriate content",
        "your live may be at risk",
        "at risk of being ended",
        "please adjust your content",
        "this live has been flagged",
        "flagged for review",
        "under review",
        "moderation notice",
        "content has been reported"
      ]
