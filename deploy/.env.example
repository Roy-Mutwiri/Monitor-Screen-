# Copy to deploy/.env and fill in. Never commit the real file.
POSTGRES_PASSWORD=change-me
# python -c "import secrets; print(secrets.token_urlsafe(48))"
HUB_SECRET_KEY=change-me
# python -m hub hash-password   (prints the pbkdf2 hash; leave empty to disable the dashboard login on a private host)
HUB_ADMIN_PASSWORD_HASH=
# for `curl -H "X-Admin-Token: ..."` automation and pairing-code creation
HUB_ADMIN_API_TOKEN=
# the URL agents and operators use (enables Secure cookies when https)
HUB_PUBLIC_URL=https://hub.example.org
HUB_PORT=8080
# Telegram bot token for the route named token_env=HUB_BOT_OPS (stays on the hub; agents never receive it)
HUB_BOT_OPS=
# Optional long-term memory of incidents/reports (hub only; never sent to agents)
SUPERMEMORY_API_KEY=
